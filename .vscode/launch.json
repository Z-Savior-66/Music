{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试主进程",
      "type": "pwa-node",
      "request": "attach",
      "address": "localhost",
      "port": 5858,
      "restart": true,
      "timeout": 30000,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "调试渲染进程",
      "type": "pwa-chrome",
      "request": "attach",
      "address": "localhost",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src",
      "timeout": 30000,
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "调试 Electron",
      "configurations": [
        "调试主进程",
        "调试渲染进程"
      ],
      "preLaunchTask": "dev",
      "stopAll": true
    }
  ]
}
